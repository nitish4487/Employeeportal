@PutMapping("/{id}")
public Employeemodel updateUser(@PathVariable String id, @RequestBody Employeemodel user) {
	Employeemodel new_user = repository.findById(id).orElse(null);
	if (new_user != null) {
		new_user.setFullName(user.getFullName());
		new_user.setEmailId(user.getEmailId());
		new_user.setAddress(user.getAddress());
		new_user.setUserName(user.getUserName());
		new_user.setPassword(user.getPassword());
		return repository.save(new_user);
	} else {
		return null;
	}
}

@DeleteMapping("/{id}")
public void deleteUser(@PathVariable String id) {
	repository.deleteById(id);
}

}

